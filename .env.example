# **************************************************************
# Best Buds
# Local environment example
# Copy this file to .env and add your local values
# **************************************************************

# Database
DB_URL=jdbc:postgresql://localhost:5432/best_buds
DB_USERNAME=best_buds_appuser
DB_PASSWORD=

# Database setup
DB_NAME=best_buds
DB_HOST=localhost
DB_ADMIN_USERNAME=postgres
DB_ADMIN_PASSWORD=
DB_OWNER_USERNAME=best_buds_owner
DB_APP_USERNAME=best_buds_appuser

# Test database
TEST_DB_NAME=best_buds_test
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_ADMIN_USERNAME=postgres
TEST_DB_ADMIN_PASSWORD=

# JWT
JWT_BASE64_SECRET=

# APIs
YELP_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
GEOAPIFY_API_KEY=
NEWS_API_KEY=

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:5173
